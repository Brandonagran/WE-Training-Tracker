    .filter-bar select { max-width: 220px; }

    .action-cell { text-align: center; }
    .btn-delete { background-color: #feb2b2; color: #9b2c2c; padding: 4px 8px; border-radius: 4px; font-size: 0.75rem; border: none; cursor: pointer; }
