<body>

<div class="container">
  <header>
    <div>
      <h1>SQDN Weekly Training Hours Tracker</h1>
    </div>
    <div id="roleBadge" class="status-badge status-user">
      <span>Role: User (Read/Write Only)</span>
    </div>
  </header>

  <form id="trainingForm">
    <h2>1. Unit & Week Identification (All Fields Mandatory)</h2>
    <div class="grid-3">
      <div>
        <label>Troop / Company <span class="req">*</span></label>
        <select id="troop" required>
          <option value="">Select Troop...</option>
          <option value="HHT">HHT</option>
          <option value="A TRP">A TRP</option>
          <option value="B TRP">B TRP</option>
          <option value="C TRP">C TRP</option>
          <option value="D CO">D CO</option>
          <option value="MICO">MICO</option>
        </select>
      </div>
      <div>
        <label>Platoon <span class="req">*</span></label>
        <select id="platoon" onchange="toggleOther('platoon', 'platoonOtherDiv', 'platoonOther')" required>
          <option value="">Select Platoon...</option>
          <option value="1PLT">1PLT</option>
          <option value="2PLT">2PLT</option>
          <option value="3PLT">3PLT</option>
          <option value="Other">Other (Specify)</option>
        </select>
        <div id="platoonOtherDiv" class="other-box hidden">
          <input type="text" id="platoonOther" placeholder="Enter Platoon / Section (e.g., HQ, Mortars)">
        </div>
      </div>
      <div>
        <label>Squad <span class="req">*</span></label>
        <select id="squad" onchange="toggleOther('squad', 'squadOtherDiv', 'squadOther')" required>
          <option value="">Select Squad...</option>
          <option value="1SQD">1SQD</option>
          <option value="2SQD">2SQD</option>
          <option value="3SQD">3SQD</option>
          <option value="Other">Other (Specify)</option>
        </select>
        <div id="squadOtherDiv" class="other-box hidden">
          <input type="text" id="squadOther" placeholder="Enter Squad / Section Name">
        </div>
      </div>
    </div>
    
    <div class="grid-2" style="margin-top: 15px;">
      <div>
        <label>Squad Leader Name & Rank <span class="req">*</span></label>
        <input type="text" id="leader" placeholder="e.g., SSG Smith" required>
      </div>
      <div>
        <label>Week Ending Date <span class="req">*</span></label>
        <input type="date" id="weekDate" required>
      </div>
    </div>

    <h2>2. Weekly Training Hours (6 Core Areas - Enter 0 if None)</h2>
    <div class="grid-3">
      <div>
        <label>Physical Fitness <span class="req">*</span></label>
        <input type="number" step="0.5" min="0" id="area1" placeholder="Hours (e.g., 5.0)" required>
      </div>
      <div>
        <label>Marksmanship <span class="req">*</span></label>
        <input type="number" step="0.5" min="0" id="area2" placeholder="Hours (e.g., 4.0)" required>
      </div>
      <div>
        <label>Small Unit Tactics <span class="req">*</span></label>
        <input type="number" step="0.5" min="0" id="area3" placeholder="Hours (e.g., 6.5)" required>
      </div>
      <div>
        <label>Medical Proficiency <span class="req">*</span></label>
        <input type="number" step="0.5" min="0" id="area4" placeholder="Hours (e.g., 2.0)" required>
      </div>
      <div>
        <label>Mobility <span class="req">*</span></label>
        <input type="number" step="0.5" min="0" id="area5" placeholder="Hours (e.g., 3.0)" required>
      </div>
      <div>
        <label>Communication <span class="req">*</span></label>
        <input type="number" step="0.5" min="0" id="area6" placeholder="Hours (e.g., 1.5)" required>
      </div>
    </div>

    <h2>3. Narrative & Distractors</h2>
    <div class="grid-2">
      <div>
        <label>Training Conducted (What was trained?) <span class="req">*</span></label>
        <textarea id="trainedDesc" placeholder="Describe tasks, standards, and equipment utilized..." required></textarea>
      </div>
      <div>
        <label>Training Distractors (What kept you from training?) <span class="req">*</span></label>
        <textarea id="distractors" placeholder="Detail any taskings, maintenance backlogs, or range delays (Enter 'None' if N/A)..." required></textarea>
      </div>
    </div>

    <div class="btn-row">
      <button type="submit" class="btn-primary">Submit Training Entry</button>
      <button type="button" class="btn-export" onclick="exportCSV()">Export to Excel (CSV)</button>
      <button type="button" id="adminLoginBtn" class="btn-login" onclick="toggleAdmin()">Admin Login</button>
      <button type="button" id="clearLogBtn" class="btn-clear hidden" onclick="clearEntries()">Clear All Logs</button>
    </div>
  </form>

  <!-- MONTHLY SQUAD ROLLUP SUMMARY -->
  <h2 style="margin-top: 40px;">Calendar Month Running Totals by Squad</h2>
  <div class="filter-bar">
    <label style="margin:0;">Filter by Calendar Month:</label>
    <select id="monthFilter" onchange="renderTable()">
      <option value="ALL">All Months</option>
    </select>
  </div>
  <div style="overflow-x:auto;">
    <table id="monthlySummaryTable">
      <thead>
        <tr>
          <th>Calendar Month</th>
          <th>Troop</th>
          <th>Plt</th>
          <th>Squad</th>
          <th>Weeks Logged</th>
          <th>FIT (Mo)</th>
          <th>MARK (Mo)</th>
          <th>SUT (Mo)</th>
          <th>MED (Mo)</th>
          <th>MOB (Mo)</th>
          <th>COMM (Mo)</th>
          <th>Month Running Total</th>
        </tr>
      </thead>
      <tbody></tbody>
    </table>
  </div>

  <!-- INDIVIDUAL WEEKLY SUBMISSIONS LOG -->
  <h2 style="margin-top: 35px;">Individual Weekly Submissions (<span id="count">0</span>)</h2>
  <div style="overflow-x:auto;">
    <table id="dataTable">
      <thead>
        <tr>
          <th>Week</th>
          <th>Month</th>
          <th>Troop</th>
          <th>Plt</th>
          <th>Squad</th>
          <th>Leader</th>
          <th>FIT</th>
          <th>MARK</th>
          <th>SUT</th>
          <th>MED</th>
          <th>MOB</th>
          <th>COMM</th>
          <th>Wk Total</th>
          <th>Month Running Total</th>
          <th>Conducted</th>
          <th>Distractors</th>
          <th id="actionsHeader" class="hidden">Actions</th>
        </tr>
      </thead>
      <tbody></tbody>
    </table>
  </div>
</div>

<script>
  const ADMIN_PASSWORD = "Beat Navy"; 
  let isAdmin = false;
  let entries = JSON.parse(localStorage.getItem('sqdnTrainingData')) || [];

  function toggleOther(selectId, divId, inputId) {
    const selectEl = document.getElementById(selectId);
    const divEl = document.getElementById(divId);
    const inputEl = document.getElementById(inputId);

    if (selectEl.value === 'Other') {
      divEl.classList.remove('hidden');
      inputEl.required = true;
    } else {
      divEl.classList.add('hidden');
      inputEl.required = false;
      inputEl.value = '';
    }
  }

  // Computes the cumulative running total for each entry within its Calendar Month (YYYY-MM) for that specific Troop/Plt/Squad
  function computeRunningTotals() {
    // Sort chronologically by weekDate, preserving insertion order for identical dates
    const indexed = entries.map((e, idx) => ({ ...e, origIndex: idx, monthKey: e.weekDate.slice(0, 7) }));
    indexed.sort((a, b) => a.weekDate.localeCompare(b.weekDate) || a.origIndex - b.origIndex);

    const runningMap = {};
    const mtdByIndex = {};

    indexed.forEach(item => {
      const unitMonthKey = `${item.monthKey}|${item.troop.toUpperCase()}|${item.platoon.toUpperCase()}|${item.squad.toUpperCase()}`;
      if (!runningMap[unitMonthKey]) {
        runningMap[unitMonthKey] = { total: 0, a1: 0, a2: 0, a3: 0, a4: 0, a5: 0, a6: 0 };
      }
      runningMap[unitMonthKey].a1 += Number(item.area1);
      runningMap[unitMonthKey].a2 += Number(item.area2);
      runningMap[unitMonthKey].a3 += Number(item.area3);
      runningMap[unitMonthKey].a4 += Number(item.area4);
      runningMap[unitMonthKey].a5 += Number(item.area5);
      runningMap[unitMonthKey].a6 += Number(item.area6);
      runningMap[unitMonthKey].total += Number(item.total);

      mtdByIndex[item.origIndex] = {
        monthKey: item.monthKey,
        runningTotal: runningMap[unitMonthKey].total.toFixed(1),
        runningA1: runningMap[unitMonthKey].a1.toFixed(1),
        runningA2: runningMap[unitMonthKey].a2.toFixed(1),
        runningA3: runningMap[unitMonthKey].a3.toFixed(1),
        runningA4: runningMap[unitMonthKey].a4.toFixed(1),
        runningA5: runningMap[unitMonthKey].a5.toFixed(1),
        runningA6: runningMap[unitMonthKey].a6.toFixed(1)
      };
    });

    return mtdByIndex;
  }

  function updateMonthFilterOptions() {
    const select = document.getElementById('monthFilter');
    const currentVal = select.value;
    const months = [...new Set(entries.map(e => e.weekDate.slice(0, 7)))].sort().reverse();
    
    select.innerHTML = '<option value="ALL">All Months</option>';
    months.forEach(m => {
      const opt = document.createElement('option');
      opt.value = m;
      opt.textContent = m;
      select.appendChild(opt);
    });
    if (months.includes(currentVal)) {
      select.value = currentVal;
    }
  }

  function renderMonthlySummary(selectedMonth) {
    const tbody = document.querySelector('#monthlySummaryTable tbody');
    tbody.innerHTML = '';

    const summaryGroups = {};
    entries.forEach(e => {
      const monthKey = e.weekDate.slice(0, 7);
      if (selectedMonth !== 'ALL' && monthKey !== selectedMonth) return;

      const key = `${monthKey}|${e.troop.toUpperCase()}|${e.platoon.toUpperCase()}|${e.squad.toUpperCase()}`;
      if (!summaryGroups[key]) {
        summaryGroups[key] = {
          month: monthKey,
          troop: e.troop,
          platoon: e.platoon,
          squad: e.squad,
          weeks: 0,
          a1: 0, a2: 0, a3: 0, a4: 0, a5: 0, a6: 0, total: 0
        };
      }
      summaryGroups[key].weeks += 1;
      summaryGroups[key].a1 += Number(e.area1);
      summaryGroups[key].a2 += Number(e.area2);
      summaryGroups[key].a3 += Number(e.area3);
      summaryGroups[key].a4 += Number(e.area4);
      summaryGroups[key].a5 += Number(e.area5);
      summaryGroups[key].a6 += Number(e.area6);
      summaryGroups[key].total += Number(e.total);
    });

    const sortedKeys = Object.keys(summaryGroups).sort().reverse();
    if (sortedKeys.length === 0) {
      tbody.innerHTML = '<tr><td colspan="12" style="text-align:center; color:#718096;">No submissions logged for the selected month.</td></tr>';
      return;
    }

    sortedKeys.forEach(k => {
      const g = summaryGroups[k];
      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td><strong>${g.month}</strong></td>
        <td>${g.troop}</td>
        <td>${g.platoon}</td>
        <td>${g.squad}</td>
        <td>${g.weeks}</td>
        <td>${g.a1.toFixed(1)}</td>
        <td>${g.a2.toFixed(1)}</td>
        <td>${g.a3.toFixed(1)}</td>
        <td>${g.a4.toFixed(1)}</td>
        <td>${g.a5.toFixed(1)}</td>
        <td>${g.a6.toFixed(1)}</td>
        <td><span class="mtd-badge">${g.total.toFixed(1)} hrs</span></td>
      `;
      tbody.appendChild(tr);
    });
  }

  function renderTable() {
    updateMonthFilterOptions();
    const selectedMonth = document.getElementById('monthFilter').value;
    renderMonthlySummary(selectedMonth);

    const mtdByIndex = computeRunningTotals();
    const tbody = document.querySelector('#dataTable tbody');
    tbody.innerHTML = '';

    const actionsHeader = document.getElementById('actionsHeader');
    if (isAdmin) {
      actionsHeader.classList.remove('hidden');
    } else {
      actionsHeader.classList.add('hidden');
    }

    let visibleCount = 0;
    entries.forEach((e, index) => {
      const mtd = mtdByIndex[index];
      if (selectedMonth !== 'ALL' && mtd.monthKey !== selectedMonth) return;
      visibleCount++;

      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td>${e.weekDate}</td>
        <td>${mtd.monthKey}</td>
        <td>${e.troop}</td>
        <td>${e.platoon}</td>
        <td>${e.squad}</td>
        <td>${e.leader}</td>
        <td>${e.area1}</td>
        <td>${e.area2}</td>
        <td>${e.area3}</td>
        <td>${e.area4}</td>
        <td>${e.area5}</td>
        <td>${e.area6}</td>
        <td><strong>${e.total}</strong></td>
        <td><span class="mtd-badge" title="FIT: ${mtd.runningA1} | MARK: ${mtd.runningA2} | SUT: ${mtd.runningA3} | MED: ${mtd.runningA4} | MOB: ${mtd.runningA5} | COMM: ${mtd.runningA6}">${mtd.runningTotal} hrs</span></td>
        <td>${e.trainedDesc}</td>
        <td>${e.distractors}</td>
        <td class="action-cell ${isAdmin ? '' : 'hidden'}">
          <button class="btn-delete" onclick="deleteEntry(${index})">Delete</button>
        </td>
      `;
      tbody.appendChild(tr);
    });

    document.getElementById('count').innerText = visibleCount;
  }

  document.getElementById('trainingForm').addEventListener('submit', function(ev) {
    ev.preventDefault();

    const pltSelect = document.getElementById('platoon').value;
    const finalPlatoon = (pltSelect === 'Other') ? document.getElementById('platoonOther').value.trim() : pltSelect;

    const sqdSelect = document.getElementById('squad').value;
    const finalSquad = (sqdSelect === 'Other') ? document.getElementById('squadOther').value.trim() : sqdSelect;

    if (!finalPlatoon || !finalSquad) {
      alert("Please specify the custom Platoon or Squad name.");
      return;
    }

    const a1 = parseFloat(document.getElementById('area1').value);
    const a2 = parseFloat(document.getElementById('area2').value);
    const a3 = parseFloat(document.getElementById('area3').value);
    const a4 = parseFloat(document.getElementById('area4').value);
    const a5 = parseFloat(document.getElementById('area5').value);
    const a6 = parseFloat(document.getElementById('area6').value);

    const entry = {
      weekDate: document.getElementById('weekDate').value,
      troop: document.getElementById('troop').value,
      platoon: finalPlatoon,
      squad: finalSquad,
      leader: document.getElementById('leader').value.trim(),
      area1: a1, area2: a2, area3: a3, area4: a4, area5: a5, area6: a6,
      total: (a1 + a2 + a3 + a4 + a5 + a6).toFixed(1),
      trainedDesc: document.getElementById('trainedDesc').value.replace(/(\r\n|\n|\r)/gm, " ").trim(),
      distractors: document.getElementById('distractors').value.replace(/(\r\n|\n|\r)/gm, " ").trim()
    };

    entries.push(entry);
    localStorage.setItem('sqdnTrainingData', JSON.stringify(entries));
    renderTable();
    
    this.reset();
    toggleOther('platoon', 'platoonOtherDiv', 'platoonOther');
    toggleOther('squad', 'squadOtherDiv', 'squadOther');
  });

  function toggleAdmin() {
    if (!isAdmin) {
      const pin = prompt("Enter Admin Password to enable delete and clear operations:");
      if (pin === ADMIN_PASSWORD) {
        isAdmin = true;
        document.getElementById('roleBadge').className = "status-badge status-admin";
        document.getElementById('roleBadge').innerHTML = "<span>Role: Administrator</span>";
        document.getElementById('adminLoginBtn').innerText = "Admin Logout";
        document.getElementById('adminLoginBtn').className = "btn-logout";
        document.getElementById('clearLogBtn').classList.remove('hidden');
        renderTable();
      } else if (pin !== null) {
        alert("Incorrect password.");
      }
    } else {
      isAdmin = false;
      document.getElementById('roleBadge').className = "status-badge status-user";
      document.getElementById('roleBadge').innerHTML = "<span>Role: User (Read/Write Only)</span>";
      document.getElementById('adminLoginBtn').innerText = "Admin Login";
      document.getElementById('adminLoginBtn').className = "btn-login";
      document.getElementById('clearLogBtn').classList.add('hidden');
      renderTable();
    }
  }

  function deleteEntry(index) {
    if (!isAdmin) return;
    if (confirm("Are you sure you want to delete this specific entry?")) {
      entries.splice(index, 1);
      localStorage.setItem('sqdnTrainingData', JSON.stringify(entries));
      renderTable();
    }
  }

  function clearEntries() {
    if (!isAdmin) return;
    if (confirm("CRITICAL WARNING: This will permanently erase ALL logged entries in this browser. Do you wish to continue?")) {
      entries = [];
      localStorage.removeItem('sqdnTrainingData');
      renderTable();
    }
  }

  function exportCSV() {
    if (entries.length === 0) { alert("No entries available to export."); return; }
    const mtdByIndex = computeRunningTotals();

    const headers = [
      "Week Ending", "Calendar Month", "Troop", "Platoon", "Squad", "Squad Leader",
      "Physical Fitness", "Marksmanship", "Small Unit Tactics", "Medical Proficiency", "Mobility", "Communication",
      "Weekly Total Hrs", "Calendar Month Running Total Hrs",
      "MTD Physical Fitness", "MTD Marksmanship", "MTD Small Unit Tactics", "MTD Medical Proficiency", "MTD Mobility", "MTD Communication",
      "Training Conducted", "Training Distractors"
    ];
    
    const rows = entries.map((e, idx) => {
      const mtd = mtdByIndex[idx];
      return [
        e.weekDate, mtd.monthKey, e.troop,
        `"${e.platoon.replace(/"/g, '""')}"`, `"${e.squad.replace(/"/g, '""')}"`, `"${e.leader.replace(/"/g, '""')}"`,
        e.area1, e.area2, e.area3, e.area4, e.area5, e.area6,
        e.total, mtd.runningTotal,
        mtd.runningA1, mtd.runningA2, mtd.runningA3, mtd.runningA4, mtd.runningA5, mtd.runningA6,
        `"${e.trainedDesc.replace(/"/g, '""')}"`, `"${e.distractors.replace(/"/g, '""')}"`
      ];
    });
    
    const csvContent = "data:text/csv;charset=utf-8," + [headers.join(","), ...rows.map(r => r.join(","))].join("\n");
    const link = document.createElement("a");
    link.setAttribute("href", encodeURI(csvContent));
    link.setAttribute("download", `SQDN_Training_Rollup_${new Date().toISOString().slice(0,10)}.csv`);
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  }

  renderTable();
</script>

</body>
</html>
